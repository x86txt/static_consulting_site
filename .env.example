# Email Provider Configuration
# Set to "sendgrid" or "resend"
EMAIL_PROVIDER=sendgrid

# SendGrid API Key (if using SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Resend API Key (if using Resend)
RESEND_API_KEY=your_resend_api_key_here

# Email address to receive contact form notifications
NOTIFICATION_EMAIL=query@mattevans.cloud

# From email address (must be verified with your email provider)
FROM_EMAIL=noreply@yourdomain.com
